{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build docs",
            "type": "shell",
            "command": ". .venv/bin/activate.fish; and sphinx-autobuild docs/source/ docs/build/html",
            "options": {
                "shell": {
                    "executable": "fish",
                    "args": ["-c"]
                }
            },
            "windows": {
                "command": ".venv\\Scripts\\activate && sphinx-autobuild docs/source/ docs/build/html"
            },
            "linux": {
                "command": ". .venv/bin/activate.fish; and sphinx-autobuild docs/source/ docs/build/html",
                "options": {
                    "shell": {
                        "executable": "fish",
                        "args": ["-c"]
                    }
                }
            },
            "osx": {
                "command": "source .venv/bin/activate && sphinx-autobuild docs/source/ docs/build/html"
            },
            "group": "build"
        },
        {
            "label": "Perform unit-test",
            "type": "shell",
            "command": ". .venv/bin/activate.fish; and python -m pytest tests/unit/ -v",
            "options": {
                "shell": {
                    "executable": "fish",
                    "args": ["-c"]
                }
            },
            "windows": {
                "command": ".venv\\Scripts\\activate && python -m pytest tests/unit/ -v"
            },
            "linux": {
                "command": ". .venv/bin/activate.fish; and python -m pytest tests/unit/ -v",
                "options": {
                    "shell": {
                        "executable": "fish",
                        "args": ["-c"]
                    }
                }
            },
            "osx": {
                "command": "source .venv/bin/activate && python -m pytest tests/unit/ -v"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}